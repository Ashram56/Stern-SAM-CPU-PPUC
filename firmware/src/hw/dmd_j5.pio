; PIO2: scanner for the original 128 x 32 Stern DMD on J5.
;
; J5 signals (odd pins, buffered by a 74HCT245 at 5 V): DE, ROWDATA, ROWCLK,
; COLLATCH_A, PIXCLK, SDATA, COLLATCH_B on GPIO20-26. Read from the drawing,
; to confirm with a meter (Q18).
;
; Two state machines, synchronised by PIO IRQ flags:
;   SM0 dmd_j5_pixels  shifts one row's 128 dots of one bit plane on SDATA with
;                      PIXCLK, when SM1 says so, and reports when done.
;   SM1 dmd_j5_ctrl    plays a list of 16-bit steps for DE, ROWDATA, ROWCLK and
;                      the two column latches, with a hold time per step.
;
; The step list (built by core0, dmd.cpp) holds every timing of a frame:
; 32 rows x 12 slots, planes shown for 1, 2, 4, 5 slots (62.67 Hz, 41.55 us per
; slot, PinMAME's figures for the FPGA scan). The dot clock, latch and row
; clock timing inside a slot are not known yet: they need a scope on an
; original board (ARCHITECTURE.md Q18). Changing them is a software change to
; the step list; neither program needs to change.
;
; SPDX-License-Identifier: GPL-3.0-or-later

; SM0. OUT pin = SDATA (GPIO25), side-set = PIXCLK (GPIO24).
; Data: 4 words per row and plane, shift right (dot 0 first), autopull 32.
.program dmd_j5_pixels
.side_set 1
    pull block          side 0          ; once at start: dots per row - 1
    mov isr, osr        side 0          ; kept in ISR (no `in` here)
.wrap_target
    wait 1 irq 4        side 0          ; SM1: shift the next row now
    mov x, isr          side 0
dot:
    out pins, 1         side 0 [1]
    jmp x-- dot         side 1 [1]      ; the display takes SDATA on PIXCLK rising
    irq set 5           side 0          ; row shifted
.wrap

; SM1. OUT pins = DE, ROWDATA, ROWCLK, COLLATCH_A (GPIO20-23), SET pin =
; COLLATCH_B (GPIO26). Step, 16 bits, shifted out LSB first (autopull 32):
;   bits 3:0   DE, ROWDATA, ROWCLK, COLLATCH_A
;   bit  4     COLLATCH_B
;   bit  5     start SM0 on the next row (irq 4)
;   bit  6     wait for SM0 to finish its row (irq 5) before this step's hold
;   bits 15:7  hold, in units of 4 PIO cycles (+ 3 cycles of step overhead)
.program dmd_j5_ctrl
.wrap_target
    out pins, 4
    out x, 1
    jmp !x latch_b_low
    set pins, 1
    jmp latch_b_done
latch_b_low:
    set pins, 0
latch_b_done:
    out x, 1
    jmp !x no_start
    irq set 4
no_start:
    out x, 1
    jmp !x no_wait
    wait 1 irq 5
no_wait:
    out x, 9
hold:
    jmp x-- hold [3]
.wrap
