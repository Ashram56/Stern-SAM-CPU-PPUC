(version 1)
# JLCPCB standard process, 4 layers, 1 oz outer / 0.5 oz inner copper.
# Source: https://jlcpcb.com/capabilities/pcb-capabilities, see README.md for the date
# and for the values that could not be checked live. Started from labtroll/KiCad-DesignRules.
# Use: copy next to the project as <project>.kicad_dru (KiCad 8 or later) AND set the
# board setup minimums listed in README.md. Copper-to-copper clearance is left to the
# board setup minimum on purpose: a custom clearance rule would override (lower) the
# project's own netclass clearances.
# In KiCad the LAST matching rule wins, so the order below matters.

(rule "JLC 4L track width (min 0.09 mm)"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.09mm))
)

# Inner layers: drilled hole to an unconnected plane (0.5 oz inner copper).
# Hole-to-track rules further down still win for tracks.
(rule "JLC 4L inner hole to plane"
	(layer inner)
	(condition "B.Type == 'Zone' && A.Net != B.Net")
	(constraint hole_clearance (min 0.2mm))
)

# ---------------------------------------------------------------- vias
# Absolute minimum JLCPCB will build: 0.15 mm drill / 0.25 mm pad.
(rule "JLC via drill (absolute min 0.15 mm)"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.15mm))
	(constraint via_diameter (min 0.25mm))
)

# Vias under 0.3 mm drill are built but add a surcharge. Warning only.
(rule "JLC via drill under 0.3 mm costs extra"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.3mm))
)

# "Via diameter should be 0.1 mm (0.15 mm preferred) larger than the hole."
(rule "JLC via annular ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.05mm))
)

# ---------------------------------------------------------------- PTH / NPTH
(rule "JLC plated hole size"
	(condition "A.Type == 'Pad' && A.isPlated()")
	(constraint hole_size (min 0.2mm) (max 6.3mm))
)

(rule "JLC NPTH hole size"
	(condition "A.Type == 'Pad' && !A.isPlated()")
	(constraint hole_size (min 0.5mm) (max 6.3mm))
)

# Production enlarges PTH rings to 0.15 mm; 0.25 mm is the recommended ring.
(rule "JLC PTH annular ring (min)"
	(condition "A.Type == 'Pad' && A.isPlated()")
	(constraint annular_width (min 0.15mm))
)

(rule "JLC PTH annular ring (recommended 0.25 mm)"
	(severity warning)
	(condition "A.Type == 'Pad' && A.isPlated()")
	(constraint annular_width (min 0.25mm))
)

# ---------------------------------------------------------------- hole to hole
(rule "JLC hole to hole, via to via"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 0.2mm))
)

(rule "JLC hole to hole, pad holes"
	(condition "A.Type == 'Pad' || B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm))
)

(rule "JLC hole to hole, different nets"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

# ---------------------------------------------------------------- hole to copper
(rule "JLC via hole to track"
	(condition "A.Type == 'Via' && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.254mm))
)

(rule "JLC PTH hole to track"
	(condition "A.Type == 'Pad' && A.isPlated() && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.33mm))
)

(rule "JLC NPTH hole to copper"
	(condition "A.Type == 'Pad' && !A.isPlated() && A.Net != B.Net")
	(constraint hole_clearance (min 0.254mm))
)

# ---------------------------------------------------------------- board edge
# Official page: tracks 0.2 mm from a routed edge; JLC support asks 0.3 mm for
# pads and pours. 0.3 mm is the error limit here, 0.4 mm for a V-cut edge.
(rule "JLC copper to routed edge"
	(constraint edge_clearance (min 0.3mm))
)

# ---------------------------------------------------------------- silkscreen
(rule "JLC silkscreen text"
	(severity warning)
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box' || A.Type == 'Field'")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1.0mm))
)

(rule "JLC pad to silkscreen"
	(severity warning)
	(layer outer)
	(condition "A.Type == 'Pad' && B.Layer == '?.Silkscreen'")
	(constraint silk_clearance (min 0.15mm))
)
