	)
	(text "Analog line-in (J30)"
		(exclude_from_sim no)
		(at 153.67 204.47 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "c0d04e29-7838-50f9-ac7e-23fc5772cfbf")
	)
	(text "Half-duplex RS485 on J27 / J29 (in parallel, top-entry RJ45: pin 1 A, pin 2 B, pins 7 / 8 GND_ISO). ADM2682E isolated\ntransceiver: the cable side (A / B, SM712 TVS, 120 R termination on JP2, RJ45 ground) is on GND_ISO, powered by the\nchip's own isoPower converter (VISO). Keep GND and GND_ISO copper apart under U32. DE / RE tied: receive by default.\nPi on J21: Pi UART3 (GPIO4 TX, GPIO5 RX, GPIO7 RTS = driver enable). Pi remote: RP2354B UART1 (GPIO20 TX, GPIO21 RX,\nGPIO22 driver enable). Both reach the transceiver through 1 k: only the configured side drives.\nJ28: I2S from a remote Pi to the PCM5102A (in parallel with J21 pins 12 / 35 / 40); keep that cable short.\nJ30: line-in (e.g. Pi 4 headphone out). No plug: DAC -> amplifiers through the jack contacts. Plug in: DAC cut off."
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "ebb95d8d-44f6-57a0-99ab-79ed4b373fbb")
	)
