	)
	(text "I2S input header (J28)"
		(exclude_from_sim no)
		(at 16.51 204.47 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ba338fa6-7b4a-53d0-9c90-62107d99553c")
	)
	(text "One half-duplex RS485 port on J27 (RJ45: pin 1 A, pin 2 B, pins 7 / 8 GND, DMX-over-RJ45 order). THVD1450: 3.3 V,\nbus fail-safe, +-18 kV ESD; SM712 TVS for the cable; 120 R termination fitted with the JP2 jumper (end of line only).\nPi on J21: Pi UART3 (GPIO4 TX, GPIO5 RX, GPIO7 RTS = driver enable, Linux RS485 mode). Pi remote: RP2354B UART1\n(GPIO20 TX, GPIO21 RX, GPIO22 driver enable). Both reach the transceiver through 1 k: only the configured side drives.\nJ28: I2S from a remote Pi to the PCM5102A (in parallel with J21 pins 12 / 35 / 40). Keep that cable short: I2S is clocked\nlogic and has the same long-wire limits as the DMD links that were removed."
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "ebb95d8d-44f6-57a0-99ab-79ed4b373fbb")
	)
