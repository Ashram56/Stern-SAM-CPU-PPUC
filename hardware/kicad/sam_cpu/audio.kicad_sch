	(text "Amplifier control: RP2354B I2C1 (GPIO38 SDA / GPIO39 SCL), PDN (GPIO35 + RC)"
		(exclude_from_sim no)
		(at 16.51 153.67 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "87502783-f8d5-4d3d-aae5-d2e9a3652b23")
	)
	(text "AMP_PDN rises 1 ms after +3V3 (10k / 100 nF) while GPIO35 is an input. GPIO35 low = hard reset /\nshutdown; the RP2354B also resets over I2C (0x01), keeps them in deep sleep until configured, then loads the PPC3 configuration over I2C\n(mode, 768 kHz switching, crossover, limiter): no sound without firmware."
		(exclude_from_sim no)
		(at 16.51 160.02 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "462704cf-fa37-4101-9e88-efc80e11c4e8")
	)
