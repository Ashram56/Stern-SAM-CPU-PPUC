	(text "6 x 74HC165 (capture, 1 sample/us) + 6 x 74HCT595 (BSS123 gates), rail inputs"
		(exclude_from_sim no)
		(at 27.94 160.02 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "695d0d23-adac-50ad-8cb0-a6347fdd5314")
	)
	(text "SAM universal test board, 48 channels, schematic draft 0.1 (2026-11-18). Licence: CERN-OHL-S v2.\nSame board x 4: coils / lamps + aux / switch matrix / dedicated switches. Role = ID0/ID1 solder jumpers.\nEach header pin: sense (to 74HC165, header A also direct to GPIO), 33 k + LEDs to the header common\n(solder jumper: RAILx from J5, GND or open), BSS123 to ground for switch simulation.\nRails on J5 are only the light-load supply: plug the USB first so the 3.3 V rail absorbs the clamp current.\nBoard ground = pinball ground (J5 pins 5-6, H1 lug). USB to the PC is isolated (ADuM3160)."
		(exclude_from_sim no)
