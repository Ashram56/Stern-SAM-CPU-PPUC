(version 1)
# Solder jumper pads (JP1-JP4: RAILx / COMx / GND): the 1.3 mm pitch footprint leaves 0.25 mm between pads,
# below the 0.6 mm HV clearance. Accepted: 50 V maximum, pads meant to be bridged by hand.
(rule "solder jumper pads"
  (constraint clearance (min 0.2))
  (condition "A.memberOfFootprint('JP*') && B.memberOfFootprint('JP*')"))
